v 40 30 -0.5
v 40 5 -0.5
v 20 5 -0.5
vt 0 1
vt 1 1
vt 1 0
vt 0 0
vn 0 0 -1
usemtl cloth_mtl
f 29/1/4 30/2/4 31/3/4
f 29/1/4 31/3/4 32/4/4

# GOLA
o collar
v -8 30 0.5
v 8 30 0.5
v 8 34 0.5
v -8 34 0.5
vt 0 1
vt 1 1
vt 1 0
vt 0 0
vn 0 0 1
usemtl collar_mtl
