# camiseta-uniforme-exclusiva - Camiseta tamanho M
# Print area frontal: 30x40cm centered on chest
# Print area costas: 30x40cm centered on back
# Units: cm

mtllib model.mtl

# FRENTE - print area
o print_front
v -15 20 1.0
v 15 20 1.0
v 15 -20 1.0
v -15 -20 1.0
vt 0 1
vt 1 1
vt 1 0
vt 0 0
vn 0 0 1
usemtl print_mtl
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# COSTAS - print area
o print_back
v -15 20 -1.0
v -15 -20 -1.0
v 15 -20 -1.0
v 15 20 -1.0
vt 0 1
vt 1 1
vt 1 0
vt 0 0
vn 0 0 -1
usemtl print_mtl
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2

# CORPO FRENTE
o body_front
v -20 30 0.5
v 20 30 0.5
v 20 -30 0.5
v -20 -30 0.5
vt 0 1
vt 1 1
vt 1 0
vt 0 0
vn 0 0 1
usemtl cloth_mtl
f 9/1/3 10/2/3 11/3/3
f 9/1/3 11/3/3 12/4/3

# CORPO COSTAS
o body_back
v -20 30 -0.5
v -20 -30 -0.5
v 20 -30 -0.5
v 20 30 -0.5
vt 0 1
vt 1 1
vt 1 0
vt 0 0
vn 0 0 -1
usemtl cloth_mtl
f 13/1/4 14/2/4 15/3/4
f 13/1/4 15/3/4 16/4/4

# MANGA ESQUERDA
o sleeve_left
v -20 30 0.5
v -40 30 0.5
v -40 5 0.5
v -20 5 0.5
vt 0 1
vt 1 1
vt 1 0
vt 0 0
vn 0 0 1
usemtl cloth_mtl
f 17/1/3 18/2/3 19/3/3
f 17/1/3 19/3/3 20/4/3

v -20 30 -0.5
v -40 30 -0.5
v -40 5 -0.5
v -20 5 -0.5
vt 0 1
vt 1 1
vt 1 0
vt 0 0
vn 0 0 -1
usemtl cloth_mtl
f 21/1/4 22/2/4 23/3/4
f 21/1/4 23/3/4 24/4/4

# MANGA DIREITA
